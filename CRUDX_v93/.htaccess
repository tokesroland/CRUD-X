Options +FollowSymLinks -MultiViews
RewriteEngine On

# Töröltük a RewriteBase-t a hordozhatóság miatt.
# Így automatikusan működik /CRUDX_v93/ mappában és gyökérben is.

# 1. Ha létező fájl (pl. style.css, képek), azonnal szolgálja ki
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. API Routing (Singular és Plural is jó legyen)
# api/products/123 -> api/v1/product_details.php?id=123
RewriteRule ^api/products?/([0-9]+)$ api/v1/product_details.php?id=$1 [L,QSA]

# 3. FRONTEND Routing (A TE HIBÁD JAVÍTÁSA)
# Fontos: A 'products/szám' szabálynak előbb kell lennie, mint a sima .php elrejtésnek!

# Kezeljük a többesszámot (amit a products.php generál): products/498 -> product.php
RewriteRule ^products/([0-9]+)$ product.php?id=$1 [L,QSA]

# Kezeljük az egyes számot is (biztonság kedvéért): product/498 -> product.php
RewriteRule ^product/([0-9]+)$ product.php?id=$1 [L,QSA]

# 4. .php kiterjesztés elrejtése (szép URL-ek a többi fájlhoz)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
